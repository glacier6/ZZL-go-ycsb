# ==========================================
# 显微镜测试配置 (Micro-benchmark)
# ==========================================
workload=core
readallfields=true

# 1. 数据集
recordcount=100

# 2. 强制顺序生成 (user0 到 user99)
insertorder=ordered

# 3. 跑操作 
operationcount=10000

# 4. 纯读模式 (排除 Update 的干扰，纯粹观察读热点)
readproportion=1
updateproportion=0
insertproportion=0.0

; requestdistribution=zipfian

requestdistribution=mixgraph
mixgraph.num_regions=100
mixgraph.exp_a=0.5
mixgraph.exp_b=-0.2
mixgraph.exp_c=0.5
mixgraph.exp_d=-0.01

mixgraph.key_dist_a=1.0
mixgraph.key_dist_b=0.25
# 前缀补0
zeropadding=10

