# ==========================================
# 显微镜测试配置 (Micro-benchmark)
# ==========================================
workload=core
readallfields=true

# 1. 极小的数据集
recordcount=1000000

# 2. 强制顺序生成 (user0 到 user99)
insertorder=ordered

# 3. 跑 1000 次操作 (平均每个 key 10 次，足够看出分布差异)
operationcount=1000000

# 4. 纯读模式 (排除 Update 的干扰，纯粹观察读热点)
readproportion=1
updateproportion=0
insertproportion=0.0

; requestdistribution=zipfian

requestdistribution=mixgraph
mixgraph.num_regions=100
mixgraph.exp_b=-0.2

# 前缀补0
zeropadding=10

