workload=core
readallfields=true

# 按照原论文，每30个区间对应500w的kv对
# 注意共有前缀的各个桶是按照数字计算的，比如user0007800000可以表示前缀是user00078这个桶，
# 所以recordcount是mixgraph.num_regions整10倍的才能正确模拟前缀
recordcount=50000000
operationcount=30000000

insertorder=ordered

# 注意readproportion等四个参数,当requestdistribution=mixgraph就会失效,需要在 NOTE:2026033001 处设置读写比例什么的

# 因为太倾斜了,所以就算改mixgraph.num_regions也没什么太大意义,而如果只是平缓貌似,也效果不好?

requestdistribution=mixgraph
# 这个参数现在根据recordcount自动计算，为recordcount/100000，设置也不会生效！
mixgraph.num_regions=500 


# ==========================================
#  前缀热度分布 (Bimodal Exponential Decay 双项指数衰减，exp_a、b、c、d控制)
# 对应 db_bench 参数: -keyrange_num 及 -keyrange_dist_a/b/c/d
# 作用: 制造极度陡峭的热点前缀 (a, b) 和极其平缓的冷区沙漠 (c, d)

#  前缀内部的 Key 倾斜度 (Pareto 长尾分布 / 幂律倾斜，key_dist_a、b控制)
# 对应 db_bench 参数: -key_dist_a 及 -key_dist_b
# 作用: 在热点前缀内部，进一步让 10% 的 Key 承受 90% 的流量
# ==========================================
# 下面是ZippyDB的真实参数
mixgraph.exp_a=14.18
mixgraph.exp_b=-2.917
mixgraph.exp_c=0.0164
mixgraph.exp_d=-0.08082
mixgraph.key_dist_a=0.002312
mixgraph.key_dist_b=0.3467

# 下面是自己写的参数


# 前缀补0，补零补的是 user 后面的数字部分,不是整个 key
zeropadding=10
fieldcount=1

# ==========================================
#  控制各个key的value长度
# ==========================================
# 启用GPD分布(论文中模拟的真实的zippyDB，已确定，V均值为34.5，5000w的key仅2.2G)
# mixgraph.gpd_value=true
# # k决定“长尾到底有多畸变、多厚,即巨无霸数据的量
# mixgraph.value_k=0.2615
# # sigma决定绝大多数“普通数据”的波动范围（胖瘦）,改动这个则是决定绝大多数普通数据的波动范围。
# mixgraph.value_sigma=25.45
# # mu设为 0 意味着这个分布在数学计算上可以生成的理论最小值是 0
# mixgraph.value_mu=0
# # fieldlength参数最好还要保留,指初始化value时初始的分配空间大小,虽然不会影响最终生成value的大小,但是设置为均值的话还是比较好的
# fieldlength=43 

# # 启用GPD分布(UDB论文没有说明应该是多长，下面是自己写的，V均值为1216字节，大于1KB的约20%)
mixgraph.gpd_value=true
# k决定“长尾到底有多畸变、多厚,即巨无霸数据的量
mixgraph.value_k=0.75
# sigma决定绝大多数“普通数据”的波动范围（胖瘦）,改动这个则是决定绝大多数普通数据的波动范围。
mixgraph.value_sigma=300
# mu设为 0 意味着这个分布在数学计算上可以生成的理论最小值是 0
mixgraph.value_mu=16
# fieldlength参数最好还要保留,指初始化value时初始的分配空间大小,虽然不会影响最终生成value的大小,但是设置为均值的话还是比较好的
fieldlength=1000 



